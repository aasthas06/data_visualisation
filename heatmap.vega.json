          "value": 0
        },
        "tooltip": [
          {"field": "state",  "type": "nominal",      "title": "State"},
          {"field": "season", "type": "ordinal",      "title": "Fire Season"},
          {"field": "count",  "type": "quantitative", "title": "Burnt Area", "format": ","}
        ]
