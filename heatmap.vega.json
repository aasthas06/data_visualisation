        "color": "#5a5a58",
        "strokeWidth": 2.5
      },
      "encoding": {
        "x": {
          "field": "season",
          "type": "ordinal",
          "title": "Fire Season",
          "sort": ["2016-17", "2017-18", "2018-19", "2019-20", "2020-21"],
          "axis": {
            "labelFontSize": 12,
